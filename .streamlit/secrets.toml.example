# Copy this file to `.streamlit/secrets.toml` (git-ignored) and fill in real keys.
# Never commit real keys. Locally you can also export them as environment
# variables of the same name instead of using this file.

# Sarvam AI speech-to-text (optional audio input)
SARVAM_API_KEY = "your-sarvam-key-here"

# Geoapify Geocoding + Places (powers "Emergency Resources" discovery + map)
# Free key: https://www.geoapify.com/
GEOAPIFY_API_KEY = "your-geoapify-key-here"

# Google Places (OPTIONAL) — phone numbers, ratings, review counts and reviews
# for matched hospitals/police/clinics. Requires a billing-enabled Google Cloud
# project with the Places API enabled. Without it the app still works; those
# fields simply show "Not available".
# https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY = "your-google-places-key-here"
